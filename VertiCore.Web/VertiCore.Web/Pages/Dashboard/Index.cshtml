@page
@model VertiCore.Web.Pages.Dashboard.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Dashboard</h2>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1 small">Total Revenue</p>
                <h4 class="fw-bold mb-0" id="totalRevenue">—</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1 small">Outstanding</p>
                <h4 class="fw-bold mb-0" id="outstandingAmount">—</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1 small">Overdue Invoices</p>
                <h4 class="fw-bold mb-0 text-danger" id="overdueCount">—</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1 small">Active Clients</p>
                <h4 class="fw-bold mb-0" id="activeClients">—</h4>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">Top Clients</h5>
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Client Name</th>
                    <th class="text-end">Revenue</th>
                </tr>
            </thead>
            <tbody id="topClientsBody">
                <tr><td colspan="2" class="text-center text-muted">Loading...</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        async function loadDashboard() {
            const token = localStorage.getItem('token');
            if (!token) {
                window.location.href = '/Auth/Login';
                return;
            }

            try {
                const response = await fetch('https://localhost:7153/api/Dashboard', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                if (!response.ok) throw new Error('Failed to load dashboard');

                const data = await response.json();

                document.getElementById('totalRevenue').innerText = 'PKR ' + data.totalRevenue.toLocaleString();
                document.getElementById('outstandingAmount').innerText = 'PKR ' + data.outstandingAmount.toLocaleString();
                document.getElementById('overdueCount').innerText = data.overdueInvoicesCount;
                document.getElementById('activeClients').innerText = data.activeClientsCount;

                const tbody = document.getElementById('topClientsBody');
                if (data.topClients.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="2" class="text-center text-muted">No data yet</td></tr>';
                } else {
                    tbody.innerHTML = data.topClients.map(c =>
                        `<tr><td>${c.clientName}</td><td class="text-end">PKR ${c.totalRevenue.toLocaleString()}</td></tr>`
                    ).join('');
                }
            } catch (error) {
                console.error(error);
            }
        }

        loadDashboard();
    </script>
}