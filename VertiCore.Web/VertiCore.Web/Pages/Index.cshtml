@page
@model VertiCore.Web.Pages.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "VertiCore — Multi-Tenant Business Management";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        :root {
            --black: #0a0a0a;
            --white: #ffffff;
            --gray-50: #f8f9fa;
            --gray-100: #f1f3f5;
            --gray-200: #e9ecef;
            --gray-400: #868e96;
            --gray-600: #495057;
            --gray-800: #212529;
            --accent: #2563eb;
            --accent-light: #eff6ff;
            --green: #16a34a;
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 20px;
        }

        html {
            scroll-behavior: smooth
        }

        body {
            font-family: 'Inter',system-ui,sans-serif;
            color: var(--gray-800);
            background: #fff;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased
        }

        /* NAV */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            background: rgba(255,255,255,0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--gray-200);
            padding: 0 24px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none
        }

        .nav-icon {
            width: 34px;
            height: 34px;
            background: var(--black);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0
        }

            .nav-icon svg {
                width: 17px;
                height: 17px;
                fill: #fff
            }

        .nav-name {
            font-size: 17px;
            font-weight: 700;
            color: var(--black);
            letter-spacing: -0.4px
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 10px
        }

        .btn-ghost {
            padding: 8px 16px;
            font-size: 14px;
            font-weight: 500;
            color: var(--gray-600);
            background: none;
            border: none;
            border-radius: var(--radius-sm);
            cursor: pointer;
            text-decoration: none;
            transition: background 0.15s,color 0.15s;
            font-family: inherit
        }

            .btn-ghost:hover {
                background: var(--gray-100);
                color: var(--black)
            }

        .btn-dark {
            padding: 9px 20px;
            font-size: 14px;
            font-weight: 600;
            color: #fff;
            background: var(--black);
            border: none;
            border-radius: var(--radius-sm);
            cursor: pointer;
            text-decoration: none;
            font-family: inherit;
            transition: background 0.15s,transform 0.1s
        }

            .btn-dark:hover {
                background: #222;
                transform: translateY(-1px)
            }

        /* HERO */
        .hero {
            padding: 140px 24px 100px;
            text-align: center;
            max-width: 800px;
            margin: 0 auto
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--accent-light);
            color: var(--accent);
            border: 1px solid #bfdbfe;
            border-radius: 100px;
            padding: 5px 14px;
            font-size: 12.5px;
            font-weight: 600;
            margin-bottom: 28px;
            letter-spacing: 0.01em
        }

        .hero-badge-dot {
            width: 6px;
            height: 6px;
            background: var(--accent);
            border-radius: 50%;
            flex-shrink: 0
        }

        .hero h1 {
            font-size: clamp(36px,6vw,64px);
            font-weight: 800;
            color: var(--black);
            line-height: 1.1;
            letter-spacing: -2px;
            margin-bottom: 22px
        }

            .hero h1 em {
                font-style: normal;
                color: var(--accent)
            }

        .hero-sub {
            font-size: 17px;
            color: var(--gray-600);
            max-width: 520px;
            margin: 0 auto 40px;
            line-height: 1.65
        }

        .hero-cta {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 14px 28px;
            font-size: 15px;
            font-weight: 700;
            color: #fff;
            background: var(--black);
            border: none;
            border-radius: var(--radius-sm);
            cursor: pointer;
            text-decoration: none;
            font-family: inherit;
            transition: background 0.15s,transform 0.15s,box-shadow 0.15s;
            box-shadow: 0 4px 14px rgba(0,0,0,0.15)
        }

            .btn-primary:hover {
                background: #1a1a1a;
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(0,0,0,0.2)
            }

            .btn-primary svg {
                width: 16px;
                height: 16px;
                transition: transform 0.15s
            }

            .btn-primary:hover svg {
                transform: translateX(3px)
            }

        .btn-outline {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 14px 28px;
            font-size: 15px;
            font-weight: 600;
            color: var(--gray-800);
            background: #fff;
            border: 1.5px solid var(--gray-200);
            border-radius: var(--radius-sm);
            cursor: pointer;
            text-decoration: none;
            font-family: inherit;
            transition: border-color 0.15s,background 0.15s,transform 0.15s
        }

            .btn-outline:hover {
                border-color: var(--gray-400);
                background: var(--gray-50);
                transform: translateY(-2px)
            }

        .hero-note {
            margin-top: 20px;
            font-size: 13px;
            color: var(--gray-400);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px
        }

            .hero-note svg {
                width: 14px;
                height: 14px
            }

        /* MOCKUP */
        .mockup-wrap {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 24px 80px
        }

        .mockup-frame {
            background: #fff;
            border: 1px solid var(--gray-200);
            border-radius: var(--radius-lg);
            box-shadow: 0 20px 60px rgba(0,0,0,0.1),0 4px 16px rgba(0,0,0,0.06);
            overflow: hidden
        }

        .mockup-bar {
            background: var(--gray-50);
            border-bottom: 1px solid var(--gray-200);
            padding: 12px 16px;
            display: flex;
            align-items: center;
            gap: 8px
        }

        .mockup-dots {
            display: flex;
            gap: 6px
        }

        .mockup-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%
        }

        .dot-red {
            background: #ff5f57
        }

        .dot-yellow {
            background: #ffbd2e
        }

        .dot-green {
            background: #28ca41
        }

        .mockup-url {
            flex: 1;
            background: #fff;
            border: 1px solid var(--gray-200);
            border-radius: 5px;
            padding: 5px 12px;
            font-size: 11px;
            color: var(--gray-400);
            margin: 0 12px
        }

        .mockup-body {
            padding: 20px;
            background: #f8f9fa
        }

        .dash-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 12px;
            margin-bottom: 16px
        }

        .dash-card {
            background: #fff;
            border-radius: 10px;
            border: 1px solid var(--gray-200);
            padding: 14px
        }

        .dash-card-label {
            font-size: 10px;
            color: var(--gray-400);
            font-weight: 500;
            margin-bottom: 4px;
            text-transform: uppercase;
            letter-spacing: 0.05em
        }

        .dash-card-value {
            font-size: 20px;
            font-weight: 700;
            color: var(--black);
            letter-spacing: -0.5px
        }

        .dash-card-sub {
            font-size: 10px;
            color: var(--green);
            font-weight: 600;
            margin-top: 2px
        }

        .dash-bottom {
            display: grid;
            grid-template-columns: 1.5fr 1fr;
            gap: 12px
        }

        .dash-panel {
            background: #fff;
            border: 1px solid var(--gray-200);
            border-radius: 10px;
            padding: 14px
        }

        .dash-panel-title {
            font-size: 11px;
            font-weight: 700;
            color: var(--black);
            margin-bottom: 12px;
            letter-spacing: -0.2px
        }

        .dash-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 7px 0;
            border-bottom: 1px solid #f1f3f5;
            font-size: 11px
        }

            .dash-row:last-child {
                border: none
            }

        .dash-row-name {
            color: var(--gray-600);
            font-weight: 500
        }

        .dash-row-val {
            color: var(--black);
            font-weight: 700
        }

        .dash-status {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 600
        }

        .status-paid {
            background: #dcfce7;
            color: #15803d
        }

        .status-sent {
            background: #dbeafe;
            color: #1d4ed8
        }

        .status-overdue {
            background: #fee2e2;
            color: #dc2626
        }

        .mini-bar-wrap {
            display: flex;
            flex-direction: column;
            gap: 8px
        }

        .mini-bar-item {
            display: flex;
            flex-direction: column;
            gap: 3px
        }

        .mini-bar-label {
            display: flex;
            justify-content: space-between;
            font-size: 10px
        }

            .mini-bar-label span:first-child {
                color: var(--gray-600)
            }

            .mini-bar-label span:last-child {
                font-weight: 700;
                color: var(--black)
            }

        .mini-bar-track {
            background: #f1f3f5;
            border-radius: 3px;
            height: 5px;
            overflow: hidden
        }

        .mini-bar-fill {
            height: 100%;
            border-radius: 3px;
            background: var(--black)
        }

        /* LOGOS */
        .logos-section {
            padding: 40px 24px;
            border-top: 1px solid var(--gray-200);
            border-bottom: 1px solid var(--gray-200);
            background: var(--gray-50)
        }

        .logos-label {
            text-align: center;
            font-size: 12px;
            color: var(--gray-400);
            font-weight: 500;
            letter-spacing: 0.05em;
            margin-bottom: 24px;
            text-transform: uppercase
        }

        .logos-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap
        }

        .logo-pill {
            background: #fff;
            border: 1px solid var(--gray-200);
            border-radius: 100px;
            padding: 10px 24px;
            font-size: 13px;
            font-weight: 700;
            color: var(--gray-400);
            letter-spacing: -0.3px
        }

        /* FEATURES */
        .section {
            padding: 80px 24px;
            max-width: 1000px;
            margin: 0 auto
        }

        .section-head {
            text-align: center;
            margin-bottom: 56px
        }

        .section-eyebrow {
            font-size: 12px;
            font-weight: 700;
            color: var(--accent);
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 12px
        }

        .section-title {
            font-size: clamp(28px,4vw,40px);
            font-weight: 800;
            color: var(--black);
            letter-spacing: -1px;
            line-height: 1.15;
            margin-bottom: 14px
        }

        .section-desc {
            font-size: 16px;
            color: var(--gray-600);
            max-width: 480px;
            margin: 0 auto;
            line-height: 1.65
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 20px
        }

        .feature-card {
            background: #fff;
            border: 1px solid var(--gray-200);
            border-radius: var(--radius-md);
            padding: 28px;
            transition: border-color 0.2s,transform 0.2s,box-shadow 0.2s
        }

            .feature-card:hover {
                border-color: var(--black);
                transform: translateY(-3px);
                box-shadow: 0 8px 24px rgba(0,0,0,0.08)
            }

        .feature-icon {
            width: 44px;
            height: 44px;
            background: var(--gray-100);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 18px;
            font-size: 20px
        }

        .feature-title {
            font-size: 15px;
            font-weight: 700;
            color: var(--black);
            margin-bottom: 8px;
            letter-spacing: -0.3px
        }

        .feature-desc {
            font-size: 13.5px;
            color: var(--gray-600);
            line-height: 1.6
        }

        /* HOW IT WORKS */
        .how-section {
            padding: 80px 24px;
            background: var(--black)
        }

        .how-inner {
            max-width: 900px;
            margin: 0 auto
        }

        .how-title {
            font-size: clamp(28px,4vw,40px);
            font-weight: 800;
            color: #fff;
            letter-spacing: -1px;
            text-align: center;
            margin-bottom: 8px
        }

        .how-sub {
            font-size: 15px;
            color: rgba(255,255,255,0.5);
            text-align: center;
            margin-bottom: 56px
        }

        .steps-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 2px
        }

        .step {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: var(--radius-md);
            padding: 28px
        }

        .step-num {
            font-size: 11px;
            font-weight: 700;
            color: rgba(255,255,255,0.25);
            letter-spacing: 0.08em;
            margin-bottom: 14px
        }

        .step-icon {
            font-size: 28px;
            margin-bottom: 14px;
            line-height: 1
        }

        .step-title {
            font-size: 15px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 8px;
            letter-spacing: -0.3px
        }

        .step-desc {
            font-size: 13px;
            color: rgba(255,255,255,0.5);
            line-height: 1.6
        }

        /* STATS */
        .stats-section {
            padding: 80px 24px;
            background: var(--gray-50);
            border-top: 1px solid var(--gray-200);
            border-bottom: 1px solid var(--gray-200)
        }

        .stats-inner {
            max-width: 800px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 32px;
            text-align: center
        }

        .stat-num {
            font-size: 36px;
            font-weight: 800;
            color: var(--black);
            letter-spacing: -1.5px;
            line-height: 1
        }

        .stat-label {
            font-size: 13px;
            color: var(--gray-400);
            margin-top: 6px;
            font-weight: 500
        }

        /* CTA */
        .cta-section {
            padding: 100px 24px;
            text-align: center
        }

        .cta-inner {
            max-width: 600px;
            margin: 0 auto
        }

        .cta-title {
            font-size: clamp(32px,5vw,52px);
            font-weight: 800;
            color: var(--black);
            letter-spacing: -2px;
            line-height: 1.1;
            margin-bottom: 18px
        }

        .cta-desc {
            font-size: 16px;
            color: var(--gray-600);
            margin-bottom: 36px;
            line-height: 1.65
        }

        /* FOOTER */
        footer {
            border-top: 1px solid var(--gray-200);
            padding: 32px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px
        }

        .footer-name {
            font-size: 14px;
            font-weight: 700;
            color: var(--black)
        }

        .footer-copy {
            font-size: 12px;
            color: var(--gray-400)
        }

        .footer-links {
            display: flex;
            gap: 20px
        }

            .footer-links a {
                font-size: 12px;
                color: var(--gray-400);
                text-decoration: none
            }

                .footer-links a:hover {
                    color: var(--black)
                }

        @@media(max-width:700px) {
            .features-grid {
                grid-template-columns: 1fr
            }

            .steps-grid {
                grid-template-columns: 1fr
            }

            .dash-grid {
                grid-template-columns: repeat(2,1fr)
            }

            .dash-bottom {
                grid-template-columns: 1fr
            }

            .stats-inner {
                grid-template-columns: repeat(2,1fr)
            }

            .hero {
                padding: 110px 16px 60px
            }

            footer {
                flex-direction: column;
                align-items: flex-start
            }
        }
    </style>
</head>
<body>

    <nav>
        <a class="nav-brand" href="/">
            <div class="nav-icon">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2L2 7v10l10 5 10-5V7L12 2zm0 2.18L20 8.5v7L12 19.82 4 15.5v-7L12 4.18z" /></svg>
            </div>
            <span class="nav-name">VertiCore</span>
        </a>
        <div class="nav-right">
            <a href="/Auth/Login" class="btn-ghost">Sign in</a>
            <a href="/Auth/Register" class="btn-dark">Get started free</a>
        </div>
    </nav>

    <section class="hero">
        <div class="hero-badge">
            <span class="hero-badge-dot"></span>
            Built on ASP.NET Core 8 &amp; Clean Architecture
        </div>
        <h1>One platform.<br><em>Every business.</em></h1>
        <p class="hero-sub">VertiCore gives your team clients, invoices, analytics, and user management — all in one multi-tenant workspace with complete data isolation.</p>
        <div class="hero-cta">
            <a href="/Auth/Register" class="btn-primary">
                Start for free
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
            </a>
            <a href="/Auth/Login" class="btn-outline">Sign in to workspace</a>
        </div>
        <p class="hero-note">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            No credit card required &nbsp;·&nbsp; Free to start &nbsp;·&nbsp; JWT-secured
        </p>
    </section>

    <div class="mockup-wrap">
        <div class="mockup-frame">
            <div class="mockup-bar">
                <div class="mockup-dots">
                    <div class="mockup-dot dot-red"></div>
                    <div class="mockup-dot dot-yellow"></div>
                    <div class="mockup-dot dot-green"></div>
                </div>
                <div class="mockup-url">localhost:7101/Dashboard/Index</div>
            </div>
            <div class="mockup-body">
                <div class="dash-grid">
                    <div class="dash-card">
                        <div class="dash-card-label">Total Revenue</div>
                        <div class="dash-card-value">$84,250</div>
                        <div class="dash-card-sub">&#8593; 12% this month</div>
                    </div>
                    <div class="dash-card">
                        <div class="dash-card-label">Outstanding</div>
                        <div class="dash-card-value">$12,400</div>
                        <div class="dash-card-sub" style="color:#d97706">3 invoices pending</div>
                    </div>
                    <div class="dash-card">
                        <div class="dash-card-label">Active Clients</div>
                        <div class="dash-card-value">47</div>
                        <div class="dash-card-sub">&#8593; 4 this week</div>
                    </div>
                    <div class="dash-card">
                        <div class="dash-card-label">Overdue</div>
                        <div class="dash-card-value">2</div>
                        <div class="dash-card-sub" style="color:#dc2626">Needs attention</div>
                    </div>
                </div>
                <div class="dash-bottom">
                    <div class="dash-panel">
                        <div class="dash-panel-title">Recent invoices</div>
                        <div class="dash-row">
                            <span class="dash-row-name">Acme Corp &nbsp;<span class="dash-status status-paid">Paid</span></span>
                            <span class="dash-row-val">$4,200</span>
                        </div>
                        <div class="dash-row">
                            <span class="dash-row-name">BrightPath Ltd &nbsp;<span class="dash-status status-sent">Sent</span></span>
                            <span class="dash-row-val">$1,850</span>
                        </div>
                        <div class="dash-row">
                            <span class="dash-row-name">NexGen Inc &nbsp;<span class="dash-status status-overdue">Overdue</span></span>
                            <span class="dash-row-val">$3,100</span>
                        </div>
                        <div class="dash-row">
                            <span class="dash-row-name">Skyline Group &nbsp;<span class="dash-status status-paid">Paid</span></span>
                            <span class="dash-row-val">$6,500</span>
                        </div>
                    </div>
                    <div class="dash-panel">
                        <div class="dash-panel-title">Top clients by revenue</div>
                        <div class="mini-bar-wrap">
                            <div class="mini-bar-item">
                                <div class="mini-bar-label"><span>Skyline Group</span><span>$24k</span></div>
                                <div class="mini-bar-track"><div class="mini-bar-fill" style="width:90%"></div></div>
                            </div>
                            <div class="mini-bar-item">
                                <div class="mini-bar-label"><span>Acme Corp</span><span>$18k</span></div>
                                <div class="mini-bar-track"><div class="mini-bar-fill" style="width:70%"></div></div>
                            </div>
                            <div class="mini-bar-item">
                                <div class="mini-bar-label"><span>BrightPath</span><span>$12k</span></div>
                                <div class="mini-bar-track"><div class="mini-bar-fill" style="width:50%"></div></div>
                            </div>
                            <div class="mini-bar-item">
                                <div class="mini-bar-label"><span>NexGen Inc</span><span>$9k</span></div>
                                <div class="mini-bar-track"><div class="mini-bar-fill" style="width:35%"></div></div>
                            </div>
