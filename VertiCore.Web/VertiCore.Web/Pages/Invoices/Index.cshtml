@page
@model VertiCore.Web.Pages.Invoices.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Invoices";
}

<!-- Toast -->
<div style="position:fixed;top:20px;right:20px;z-index:9999;" id="toastWrap"></div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Invoices</h2>
    <a asp-page="/Invoices/Create" class="btn btn-dark">+ New Invoice</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="px-4 py-3">Invoice #</th>
                    <th class="px-4 py-3">Client</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3">Amount</th>
                    <th class="px-4 py-3">Due Date</th>
                    <th class="px-4 py-3">Actions</th>
                </tr>
            </thead>
            <tbody id="invoicesBody">
                <tr><td colspan="6" class="text-center text-muted py-4">Loading...</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const statusMap   = ['Draft', 'Sent', 'Paid', 'Overdue'];
        const statusColor = { 'Draft': 'secondary', 'Sent': 'primary', 'Paid': 'success', 'Overdue': 'danger' };

        async function loadInvoices() {
            const token = localStorage.getItem('token');
            if (!token) { window.location.href = '/Auth/Login'; return; }

            try {
                const response = await fetch('https://localhost:7153/api/Invoice', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                if (!response.ok) throw new Error('Failed to load invoices');

                const data = await response.json();
                const invoices = data.data ?? data;
                const tbody = document.getElementById('invoicesBody');

                if (!invoices || invoices.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No invoices yet</td></tr>';
                    return;
                }

                tbody.innerHTML = invoices.map(inv => {
                    const statusText = statusMap[inv.status] || 'Unknown';
                    return `
                    <tr>
                        <td class="px-4 py-3 fw-semibold">${inv.invoiceNumber}</td>
                        <td class="px-4 py-3">${inv.clientName}</td>
                        <td class="px-4 py-3">
                            <select class="form-select form-select-sm status-select"
                                    data-id="${inv.id}"
                                    data-current="${inv.status}"
                                    style="width:110px;border-radius:8px;">
                                <option value="0" ${inv.status === 0 ? 'selected' : ''}>Draft</option>
                                <option value="1" ${inv.status === 1 ? 'selected' : ''}>Sent</option>
                                <option value="2" ${inv.status === 2 ? 'selected' : ''}>Paid</option>
                                <option value="3" ${inv.status === 3 ? 'selected' : ''}>Overdue</option>
                            </select>
                        </td>
                        <td class="px-4 py-3">PKR ${inv.totalAmount.toLocaleString()}</td>
                        <td class="px-4 py-3">${new Date(inv.dueDate).toLocaleDateString()}</td>
                        <td class="px-4 py-3">
                            <button class="btn btn-sm btn-outline-dark download-pdf" data-id="${inv.id}">PDF</button>
                        </td>
                    </tr>`;
                }).join('');

            } catch (error) {
                console.error(error);
            }
        }

        // Status update
        document.getElementById('invoicesBody').addEventListener('change', async function (e) {
            if (!e.target.classList.contains('status-select')) return;

            const id       = e.target.dataset.id;
            const newStatus = parseInt(e.target.value);
            const oldStatus = parseInt(e.target.dataset.current);
            const token    = localStorage.getItem('token');

            try {
                const res = await fetch(`https://localhost:7153/api/Invoice/${id}/status`, {
                    method: 'PUT',
                    headers: {
                        'Authorization': 'Bearer ' + token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(newStatus)
                });

                const data = await res.json();
                if (!res.ok || !data.success) throw new Error(data.message || 'Status update failed');

                e.target.dataset.current = newStatus;
                showToast('Status updated', 'success');

            } catch (err) {
                e.target.value = oldStatus; // revert
                showToast(err.message, 'error');
            }
        });

        // PDF download
        document.getElementById('invoicesBody').addEventListener('click', async function (e) {
            if (!e.target.classList.contains('download-pdf')) return;

            const id    = e.target.dataset.id;
            const token = localStorage.getItem('token');

            try {
                const response = await fetch(`https://localhost:7153/api/Invoice/${id}/pdf`, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                const blob = await response.blob();
                const url  = window.URL.createObjectURL(blob);
                const a    = document.createElement('a');
                a.href     = url;
                a.download = `invoice_${id}.pdf`;
                a.click();
            } catch (err) {
                showToast('PDF download failed', 'error');
            }
        });

        // Toast
        function showToast(msg, type = 'success') {
            const wrap = document.getElementById('toastWrap');
            const el   = document.createElement('div');
            el.style.cssText = `
                display:flex;align-items:center;gap:10px;padding:12px 16px;
                border-radius:12px;font-size:13px;font-weight:500;
                min-width:220px;box-shadow:0 4px 20px rgba(0,0,0,0.12);margin-bottom:8px;
                background:${type === 'success' ? '#f0fdf4' : '#fff5f5'};
                border:1px solid ${type === 'success' ? '#bbf7d0' : '#fecaca'};
                color:${type === 'success' ? '#15803d' : '#b91c1c'};
            `;
            el.innerHTML = `<span>${type === 'success' ? '✓' : '✕'}</span><span>${msg}</span>`;
            wrap.appendChild(el);
            setTimeout(() => el.remove(), 3000);
        }

        loadInvoices();
    </script>
}
