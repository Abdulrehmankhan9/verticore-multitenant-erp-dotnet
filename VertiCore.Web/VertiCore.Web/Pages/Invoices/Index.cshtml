@page
@model VertiCore.Web.Pages.Invoices.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Invoices";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Invoices</h2>
    <a asp-page="/Invoices/Create" class="btn btn-dark">+ New Invoice</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Client</th>
                    <th>Status</th>
                    <th>Amount</th>
                    <th>Due Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="invoicesBody">
                <tr><td colspan="6" class="text-center text-muted">Loading...</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const statusMap = ['Draft', 'Sent', 'Paid', 'Overdue'];
        const statusColor = { 'Draft': 'secondary', 'Sent': 'primary', 'Paid': 'success', 'Overdue': 'danger' };

        async function loadInvoices() {
            const token = localStorage.getItem('token');
            if (!token) {
                window.location.href = '/Auth/Login';
                return;
            }

            try {
                const response = await fetch('https://localhost:7153/api/Invoice', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                if (!response.ok) throw new Error('Failed to load invoices');

                const invoices = await response.json();
                const tbody = document.getElementById('invoicesBody');

                if (invoices.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No invoices yet</td></tr>';
                } else {
                    tbody.innerHTML = invoices.map(inv => {
                        const statusText = statusMap[inv.status];
                        return `
                        <tr>
                            <td>${inv.invoiceNumber}</td>
                            <td>${inv.clientName}</td>
                            <td><span class="badge bg-${statusColor[statusText]}">${statusText}</span></td>
                            <td>PKR ${inv.totalAmount.toLocaleString()}</td>
                            <td>${new Date(inv.dueDate).toLocaleDateString()}</td>
                            <td><button class="btn btn-sm btn-outline-dark download-pdf" data-id="${inv.id}">PDF</button></td>
                        </tr>`;
                    }).join('');
                }
            } catch (error) {
                console.error(error);
            }
        }

        loadInvoices();

        document.getElementById('invoicesBody').addEventListener('click', async function (e) {
            if (e.target.classList.contains('download-pdf')) {
                const id = e.target.dataset.id;
                const token = localStorage.getItem('token');

                const response = await fetch(`https://localhost:7153/api/Invoice/${id}/pdf`, {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `invoice_${id}.pdf`;
                a.click();
            }
        });
    </script>
}