@page
@model VertiCore.Web.Pages.Clients.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Clients";
}

<!-- Toast -->
<div style="position:fixed;top:20px;right:20px;z-index:9999;" id="toastWrap"></div>

<!-- Delete Confirm Modal -->
<div id="deleteModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.35);z-index:1000;align-items:center;justify-content:center;padding:20px;">
    <div style="background:#fff;border-radius:16px;border:1px solid #e4e7ec;box-shadow:0 8px 40px rgba(0,0,0,0.14);width:100%;max-width:380px;padding:28px;">
        <div style="font-size:32px;margin-bottom:12px;">🗑️</div>
        <h5 style="font-weight:700;color:#111;margin:0 0 6px;">Delete client?</h5>
        <p style="font-size:13px;color:#8a8f98;margin:0 0 22px;">This action cannot be undone.</p>
        <div style="display:flex;gap:10px;">
            <button onclick="closeDeleteModal()" style="flex:1;height:40px;background:#f1f3f5;border:none;border-radius:10px;font-size:13.5px;font-weight:600;cursor:pointer;">Cancel</button>
            <button onclick="confirmDelete()" id="confirmDeleteBtn" style="flex:2;height:40px;background:#dc2626;color:#fff;border:none;border-radius:10px;font-size:13.5px;font-weight:600;cursor:pointer;">Delete</button>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Clients</h2>
    <a asp-page="/Clients/Create" class="btn btn-dark">+ New Client</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="px-4 py-3">Name</th>
                    <th class="px-4 py-3">Email</th>
                    <th class="px-4 py-3">Phone</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3">Actions</th>
                </tr>
            </thead>
            <tbody id="clientsBody">
                <tr><td colspan="5" class="text-center text-muted py-4">Loading...</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        let deleteClientId = null;

        async function loadClients() {
            const token = localStorage.getItem('token');
            if (!token) { window.location.href = '/Auth/Login'; return; }

            try {
                const response = await fetch('https://localhost:7153/api/Client', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                const data = await response.json();
                const tbody = document.getElementById('clientsBody');
                const clients = data.data ?? data;

                if (!clients || clients.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">No clients yet</td></tr>';
                    return;
                }

                tbody.innerHTML = clients.map(c => `
                    <tr>
                        <td class="px-4 py-3 fw-semibold">${c.fullName}</td>
                        <td class="px-4 py-3">${c.email}</td>
                        <td class="px-4 py-3">${c.phone || '-'}</td>
                        <td class="px-4 py-3">
                            <span class="badge ${c.isActive ? 'bg-success' : 'bg-secondary'}">
                                ${c.isActive ? 'Active' : 'Inactive'}
                            </span>
                        </td>
                        <td class="px-4 py-3">
                            <a href="/Clients/Edit?id=${c.id}" class="btn btn-sm btn-outline-dark me-1">Edit</a>
                            <button onclick="openDeleteModal('${c.id}')" class="btn btn-sm btn-outline-danger">Delete</button>
                        </td>
                    </tr>
                `).join('');

            } catch (error) {
                console.error(error);
            }
        }

        // Delete modal
        function openDeleteModal(id) {
            deleteClientId = id;
            document.getElementById('deleteModal').style.display = 'flex';
        }

        function closeDeleteModal() {
            deleteClientId = null;
            document.getElementById('deleteModal').style.display = 'none';
        }

        async function confirmDelete() {
            const token = localStorage.getItem('token');
            if (!token || !deleteClientId) return;

            const btn = document.getElementById('confirmDeleteBtn');
            btn.textContent = 'Deleting...';
            btn.disabled = true;

            try {
                const res = await fetch(`https://localhost:7153/api/Client/${deleteClientId}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                const data = await res.json();
                if (!res.ok || !data.success) throw new Error(data.message || 'Delete failed');

                closeDeleteModal();
                showToast('Client deleted', 'success');
                setTimeout(loadClients, 600);

            } catch (err) {
                showToast(err.message, 'error');
                btn.textContent = 'Delete';
                btn.disabled = false;
            }
        }

        // Toast
        function showToast(msg, type = 'success') {
            const wrap = document.getElementById('toastWrap');
            const el = document.createElement('div');
            el.style.cssText = `
                display:flex;align-items:center;gap:10px;padding:12px 16px;
                border-radius:12px;font-size:13px;font-weight:500;
                min-width:220px;box-shadow:0 4px 20px rgba(0,0,0,0.12);
                margin-bottom:8px;
                background:${type === 'success' ? '#f0fdf4' : '#fff5f5'};
                border:1px solid ${type === 'success' ? '#bbf7d0' : '#fecaca'};
                color:${type === 'success' ? '#15803d' : '#b91c1c'};
            `;
            el.innerHTML = `<span>${type === 'success' ? '✓' : '✕'}</span><span>${msg}</span>`;
            wrap.appendChild(el);
            setTimeout(() => el.remove(), 3000);
        }

        loadClients();
    </script>
}
