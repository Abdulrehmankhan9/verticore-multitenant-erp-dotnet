@page
@model VertiCore.Web.Pages.Auth.SetPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Set Password";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    *, *::before, *::after {
        box-sizing: border-box;
    }

    body {
        background: #f0f2f5;
        font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
        min-height: 100vh;
        margin: 0;
    }

    .page-wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
    }

    .auth-shell {
        width: 100%;
        max-width: 440px;
    }

    .brand {
        text-align: center;
        margin-bottom: 28px;
    }

    .brand-logo {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        margin-bottom: 8px;
    }

    .brand-icon {
        width: 36px;
        height: 36px;
        background: #1a1a1a;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .brand-icon svg {
            width: 18px;
            height: 18px;
            fill: #fff;
        }

    .brand-wordmark {
        font-size: 20px;
        font-weight: 700;
        color: #1a1a1a;
        letter-spacing: -0.4px;
    }

    .brand-sub {
        font-size: 13px;
        color: #8a8f98;
        margin: 0;
    }

    .auth-card {
        background: #fff;
        border-radius: 18px;
        border: 1px solid #e4e7ec;
        box-shadow: 0 2px 16px rgba(0,0,0,0.06), 0 0 0 1px rgba(0,0,0,0.02);
        padding: 32px;
    }

    .card-icon {
        width: 48px;
        height: 48px;
        background: #f1f3f5;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
        font-size: 22px;
    }

    .card-head h1 {
        font-size: 18px;
        font-weight: 700;
        color: #111;
        margin: 0 0 4px;
        letter-spacing: -0.3px;
    }

    .card-head p {
        font-size: 13px;
        color: #8a8f98;
        margin: 0 0 24px;
    }

    .alert-box {
        display: none;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 18px;
        align-items: flex-start;
        gap: 8px;
    }

        .alert-box.visible {
            display: flex;
        }

    .alert-error {
        background: #fff5f5;
        border: 1px solid #fecaca;
        color: #b91c1c;
    }

    .alert-success {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #15803d;
    }

    .alert-icon {
        flex-shrink: 0;
        margin-top: 1px;
        font-size: 15px;
        line-height: 1;
    }

    .field {
        margin-bottom: 16px;
    }

    .field-label {
        display: block;
        font-size: 12.5px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 6px;
        letter-spacing: 0.01em;
    }

    .field-input {
        width: 100%;
        height: 42px;
        padding: 0 14px;
        font-size: 14px;
        font-family: inherit;
        color: #111;
        background: #fff;
        border: 1.5px solid #e4e7ec;
        border-radius: 10px;
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
        appearance: none;
    }

        .field-input::placeholder {
            color: #c0c5ce;
        }

        .field-input:focus {
            border-color: #1a1a1a;
            box-shadow: 0 0 0 3px rgba(26,26,26,0.07);
        }

    .pwd-wrap {
        position: relative;
    }

        .pwd-wrap .field-input {
            padding-right: 52px;
        }

    .pwd-eye {
        position: absolute;
        right: 0;
        top: 0;
        height: 42px;
        width: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: none;
        border: none;
        cursor: pointer;
        color: #9ca3af;
        padding: 0;
        border-radius: 0 10px 10px 0;
        transition: color 0.15s;
    }

        .pwd-eye:hover {
            color: #374151;
        }

        .pwd-eye svg {
            width: 18px;
            height: 18px;
            pointer-events: none;
        }

    /* Password strength bar */
    .strength-wrap {
        margin-top: 8px;
    }

    .strength-track {
        height: 4px;
        background: #e9ecef;
        border-radius: 4px;
        overflow: hidden;
        margin-bottom: 5px;
    }

    .strength-fill {
        height: 100%;
        border-radius: 4px;
        width: 0%;
        transition: width 0.3s, background 0.3s;
    }

    .strength-label {
        font-size: 11.5px;
        font-weight: 600;
        color: #adb5bd;
    }

    .submit-btn {
        width: 100%;
        height: 44px;
        background: #1a1a1a;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        margin-top: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background 0.15s, opacity 0.15s;
        letter-spacing: 0.01em;
    }

        .submit-btn:hover {
            background: #2d2d2d;
        }

        .submit-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        flex-shrink: 0;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .back-link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        margin-top: 20px;
        font-size: 13px;
        color: #8a8f98;
        text-decoration: none;
    }

        .back-link svg {
            width: 14px;
            height: 14px;
        }

        .back-link:hover {
            color: #1a1a1a;
        }

    .copy {
        text-align: center;
        font-size: 12px;
        color: #c0c5ce;
        margin-top: 20px;
    }

    /* Token error state */
    .token-error {
        text-align: center;
        padding: 8px 0 16px;
    }

    .token-error-icon {
        font-size: 36px;
        margin-bottom: 12px;
    }

    .token-error h2 {
        font-size: 16px;
        font-weight: 700;
        color: #111;
        margin-bottom: 6px;
    }

    .token-error p {
        font-size: 13px;
        color: #8a8f98;
        margin-bottom: 20px;
        line-height: 1.5;
    }
</style>

<div class="page-wrap">
    <div class="auth-shell">

        <div class="brand">
            <a class="brand-logo" href="/">
                <div class="brand-icon">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L2 7v10l10 5 10-5V7L12 2zm0 2.18L20 8.5v7L12 19.82 4 15.5v-7L12 4.18z" />
                    </svg>
                </div>
                <span class="brand-wordmark">VertiCore</span>
            </a>
            <p class="brand-sub">Multi-tenant business management</p>
        </div>

        <div class="auth-card" id="mainCard">
            <!-- Default: form view -->
            <div id="formView">
                <div class="card-icon">🔑</div>
                <div class="card-head">
                    <h1>Set your password</h1>
                    <p>Choose a strong password to secure your account</p>
                </div>

                <div id="errorAlert" class="alert-box alert-error" role="alert">
                    <span class="alert-icon">✕</span>
                    <span id="errorMsg"></span>
                </div>
                <div id="successAlert" class="alert-box alert-success" role="alert">
                    <span class="alert-icon">✓</span>
                    <span id="successMsg"></span>
                </div>

                <form id="setPasswordForm" autocomplete="off" novalidate>

                    <div class="field">
                        <label class="field-label" for="password">New password</label>
                        <div class="pwd-wrap">
                            <input class="field-input" type="password" id="password"
                                   placeholder="Minimum 8 characters" autocomplete="new-password" required />
                            <button class="pwd-eye" type="button" id="togglePwd1" aria-label="Show password">
                                <svg id="eye1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg id="eyeOff1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                    <line x1="1" y1="1" x2="23" y2="23" />
                                </svg>
                            </button>
                        </div>
                        <div class="strength-wrap">
                            <div class="strength-track"><div class="strength-fill" id="strengthFill"></div></div>
                            <span class="strength-label" id="strengthLabel"></span>
                        </div>
                    </div>

                    <div class="field">
                        <label class="field-label" for="confirmPassword">Confirm password</label>
                        <div class="pwd-wrap">
                            <input class="field-input" type="password" id="confirmPassword"
                                   placeholder="Re-enter your password" autocomplete="new-password" required />
                            <button class="pwd-eye" type="button" id="togglePwd2" aria-label="Show password">
                                <svg id="eye2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg id="eyeOff2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                    <line x1="1" y1="1" x2="23" y2="23" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="submit-btn" id="submitBtn">
                        Set password
                    </button>
                </form>
            </div>

            <!-- Token missing state (shown if no token in URL) -->
            <div id="tokenErrorView" style="display:none;">
                <div class="token-error">
                    <div class="token-error-icon">⚠️</div>
                    <h2>Invalid or expired link</h2>
                    <p>This password setup link is missing or has expired.<br>Please ask your admin to send a new invite.</p>
                    <a href="/Auth/Login" class="submit-btn" style="text-decoration:none;display:flex;">
                        Back to sign in
                    </a>
                </div>
            </div>
        </div>

        <a href="/Auth/Login" class="back-link" id="backLink">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 5l-7 7 7 7" />
            </svg>
            Back to sign in
        </a>

        <p class="copy">© 2026 VertiCore · All rights reserved</p>
    </div>
</div>

@section Scripts {
    <script>
        // Read token from URL
        const token = new URLSearchParams(window.location.search).get('token');

        // If no token, show error state
        if (!token) {
            document.getElementById('formView').style.display = 'none';
            document.getElementById('tokenErrorView').style.display = 'block';
            document.getElementById('backLink').style.display = 'none';
        }

        // Password toggle — field 1
        const pwd1 = document.getElementById('password');
        document.getElementById('togglePwd1').addEventListener('click', function () {
            const show = pwd1.type === 'password';
            pwd1.type = show ? 'text' : 'password';
            document.getElementById('eye1').style.display    = show ? 'none' : '';
            document.getElementById('eyeOff1').style.display = show ? '' : 'none';
        });

        // Password toggle — field 2
        const pwd2 = document.getElementById('confirmPassword');
        document.getElementById('togglePwd2').addEventListener('click', function () {
            const show = pwd2.type === 'password';
            pwd2.type = show ? 'text' : 'password';
            document.getElementById('eye2').style.display    = show ? 'none' : '';
            document.getElementById('eyeOff2').style.display = show ? '' : 'none';
        });

        // Password strength
        pwd1.addEventListener('input', function () {
            const val = pwd1.value;
            const fill  = document.getElementById('strengthFill');
            const label = document.getElementById('strengthLabel');

            if (!val) { fill.style.width = '0%'; label.textContent = ''; return; }

            let score = 0;
            if (val.length >= 8)  score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            const map = [
                { w: '25%', color: '#ef4444', text: 'Weak' },
                { w: '50%', color: '#f97316', text: 'Fair' },
                { w: '75%', color: '#eab308', text: 'Good' },
                { w: '100%',color: '#22c55e', text: 'Strong' }
            ];
            const s = map[score - 1] || map[0];
            fill.style.width      = s.w;
            fill.style.background = s.color;
            label.style.color     = s.color;
            label.textContent     = s.text;
        });

        // Alert helpers
        function showError(msg) {
            const el = document.getElementById('errorAlert');
            document.getElementById('errorMsg').textContent = msg;
            el.classList.add('visible');
            document.getElementById('successAlert').classList.remove('visible');
        }
        function showSuccess(msg) {
            const el = document.getElementById('successAlert');
            document.getElementById('successMsg').textContent = msg;
            el.classList.add('visible');
            document.getElementById('errorAlert').classList.remove('visible');
        }
        function clearAlerts() {
            document.getElementById('errorAlert').classList.remove('visible');
            document.getElementById('successAlert').classList.remove('visible');
        }

        // Submit
        document.getElementById('setPasswordForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            clearAlerts();

            const password        = pwd1.value;
            const confirmPassword = pwd2.value;

            if (password.length < 8) {
                showError('Password must be at least 8 characters.');
                return;
            }
            if (password !== confirmPassword) {
                showError('Passwords do not match.');
                return;
            }

            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<div class="spinner"></div>Setting password…';

            try {
                const response = await fetch('https://localhost:7153/api/User/set-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token: token, password: password })
                });

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.message || 'Failed to set password. Please try again.');
                }

                showSuccess('Password set! Redirecting to sign in…');

                setTimeout(() => {
                    window.location.href = '/Auth/Login?message=Password+set+successfully';
                }, 1800);

            } catch (error) {
                showError(error.message);
                btn.disabled = false;
                btn.innerHTML = 'Set password';
            }
        });
    </script>
}
